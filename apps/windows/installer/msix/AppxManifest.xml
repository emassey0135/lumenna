<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumenna as an MSIX package, for the Microsoft Store, which signs and updates it. Filled in and
  packed by `pack.ps1` for the release workflow: its name, description and version (@NAME@,
  @DESCRIPTION@, @VERSION@) from the workspace's Cargo.toml (`[workspace.metadata.lumenna]`), so
  they are said there alone.

  The identity (@IDENTITY_NAME@, @PUBLISHER@) is a stand-in until Partner Center reserves the name
  and gives the real ones, which the workflow then takes from the repository's variables. A
  package's AppData writes are redirected into its own folder, so the app keeps its store there
  outright (`profile::default_directory`), apart from an install from the installer: the two are
  two devices, to pair if both are wanted.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop com rescap">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>@NAME@</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 10 2004, the first with console applications in a package (`uap10:Subsystem`). -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26200.0" />
    <!-- The Windows App Runtime, for the Widgets board's API (`win/widgets`): a framework the
         Store installs with the package, and `test.ps1` installs before it. -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.0.1.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="Lumenna" Executable="lumenna.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="@NAME@" Description="@DESCRIPTION@"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Opening at sign-in (`win/package.rs`): off until the person turns it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="lumenna.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LumennaAtSignIn" Enabled="false" DisplayName="@NAME@" />
        </desktop:Extension>
        <!-- The Widgets board's provider (`win/widgets`): the app, started with the argument
             below as a COM server of this class, which the widget extension after it names. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="lumenna.exe" Arguments="--widgets" DisplayName="@NAME@">
              <com:Class Id="18D24380-6221-4EAF-975D-40086936D300" DisplayName="@NAME@" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <!-- Its widgets, the core's (`lumenna_records::glance::widgets`, whose test checks these
             names and descriptions): Now, small (what is happening now, and the timer running),
             and Today, medium (that, the next block, and what is due, each with its Mark Done).
             The card drawn is chosen by size, so each offers only its own. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" Id="Lumenna" DisplayName="@NAME@">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\WidgetIcon.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="18D24380-6221-4EAF-975D-40086936D300" />
                </Activation>
                <Definitions>
                  <Definition Id="now" DisplayName="Now" Description="What is happening now, and the timer running" AllowMultiple="true">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\WidgetIcon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\WidgetScreenshot.png" DisplayAltText="Now" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                  <Definition Id="today" DisplayName="Today" Description="What is happening now, what is next, and the tasks due" AllowMultiple="true">
                    <Capabilities>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\WidgetIcon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\WidgetScreenshot.png" DisplayAltText="Today" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>

    <!-- `lum`, reached from any terminal by its alias, in the package and so with its store. -->
    <Application Id="Lum" Executable="lum.exe" EntryPoint="Windows.FullTrustApplication"
      uap10:Subsystem="console" uap10:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="lum" Description="Lumenna on the command line" AppListEntry="none"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="lum.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="lum.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
