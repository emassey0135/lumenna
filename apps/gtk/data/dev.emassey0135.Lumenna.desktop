[Desktop Entry]
Type=Application
Name=Lumenna
GenericName=Task Manager and Day Planner
Comment=Tasks, and the time blocks you work through them in
Exec=lumenna-gtk
Icon=dev.emassey0135.Lumenna
Terminal=false
Categories=Office;ProjectManagement;Calendar;GTK;
Keywords=tasks;todo;planner;time blocks;
StartupNotify=true
DBusActivatable=false
X-GNOME-UsesNotifications=true
Actions=new-task;today;what-now;

[Desktop Action new-task]
Name=New Task
Exec=lumenna-gtk --launch new-task

[Desktop Action today]
Name=Today
Exec=lumenna-gtk --launch today

[Desktop Action what-now]
Name=What Should I Work On?
Exec=lumenna-gtk --launch what-now
