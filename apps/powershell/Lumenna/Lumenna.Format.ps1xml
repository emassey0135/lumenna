<?xml version="1.0" encoding="utf-8"?>
<!-- How Lumenna's records show at the prompt: a listing's rows as a table of what lum says of
     them, and a change by its announcement alone, the core's sentence. Every property is still
     there for a script, and Format-List * shows them all. -->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Lumenna.Row</Name>
      <ViewSelectedBy>
        <TypeName>Lumenna.Row</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>Due</Label></TableColumnHeader>
          <TableColumnHeader><Label>Time</Label></TableColumnHeader>
          <TableColumnHeader><Label>Value</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>('  ' * [int] $_.depth) + $_.title</ScriptBlock></TableColumnItem>
              <!-- The day and the time apart, as the core gives them: a sentence of the two is
                   the core's to compose, and it composes none. -->
              <TableColumnItem><PropertyName>due</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>due_time</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>value</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>id</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Lumenna.Choice</Name>
      <ViewSelectedBy>
        <TypeName>Lumenna.Choice</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
          <TableColumnHeader><Label>Reason</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>title</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>detail</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>reason</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Lumenna.Filter</Name>
      <ViewSelectedBy>
        <TypeName>Lumenna.Filter</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Query</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>query</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Lumenna.Operation</Name>
      <ViewSelectedBy>
        <TypeName>Lumenna.Operation</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Cmdlet</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>cmdlet</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>title</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Lumenna.Announced</Name>
      <ViewSelectedBy>
        <TypeName>Lumenna.Change</TypeName>
        <TypeName>Lumenna.Timer</TypeName>
        <TypeName>Lumenna.Replanned</TypeName>
        <TypeName>Lumenna.DayPlanned</TypeName>
      </ViewSelectedBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <ExpressionBinding><PropertyName>announcement</PropertyName></ExpressionBinding>
              <NewLine />
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>
  </ViewDefinitions>
</Configuration>
