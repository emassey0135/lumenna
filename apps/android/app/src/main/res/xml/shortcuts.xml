<?xml version="1.0" encoding="utf-8"?>
<!-- New Task on the app icon's long press, and in TalkBack's actions on the icon: quick add
     without first finding the Tasks tab. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_new_task"
        android:shortcutId="new-task"
        android:shortcutLongLabel="@string/new_task"
        android:shortcutShortLabel="@string/new_task">
        <intent
            android:action="io.github.emassey0135.lumenna.NEW_TASK"
            android:targetClass="io.github.emassey0135.lumenna.MainActivity"
            android:targetPackage="io.github.emassey0135.lumenna" />
    </shortcut>
</shortcuts>
