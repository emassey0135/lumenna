<?xml version="1.0" encoding="utf-8"?>
<!-- A running timer on a widget: the platform's chronometer, counting from the core's
     counting_from by itself, so the widget is drawn again only when the glance changes. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:textColor="@color/widget_text"
    android:textSize="24sp" />
