<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Syncing with paired devices: Iroh connections, and knowing when there is a network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Hearing other devices on the local network (DNS-SD): Android passes multicast to an app
         only while it holds a multicast lock, which needs this. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Reminders: shown as notifications (asked for from Android 13, when the person first
         adds a reminder or turns them on), at their exact time where the person allows it
         (SCHEDULE_EXACT_ALARM, which they grant in the system's Alarms and reminders; refused,
         alarms are inexact and Settings says so), and set again after the device starts.
         Not USE_EXACT_ALARM: Google Play keeps it for alarm clocks and calendars, and a task
         manager whose reminders come a few minutes late without it is neither. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The store is not backed up to Google: it lives in no-backup storage, and syncing between
         paired devices is the way it reaches another. -->
    <application
        android:name=".LumennaApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumenna">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The core's launch shortcuts (Launches), set at run time: the icon's shortcuts, the
                 Quick Settings tile and the widgets open the app on one. NEW_TASK is what the
                 launcher's shortcut asked for before, which a shortcut pinned then still does. -->
            <intent-filter>
                <action android:name="dev.emassey0135.lumenna.LAUNCH" />
                <action android:name="dev.emassey0135.lumenna.NEW_TASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".NewTaskTile"
            android:exported="true"
            android:icon="@drawable/ic_new_task"
            android:label="@string/new_task"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Gemini's App Functions (functions/LumennaFunctions): the service the library
             generates, bound only by the system for a caller allowed to execute app functions,
             and the XML it writes describing each function, which the system indexes: the v1 file
             for Android 16's indexer, the v2 for Android 17's. -->
        <service
            android:name=".functions.LumennaFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
            <property
                android:name="android.app.appfunctions"
                android:value="lumenna_functions-v1.xml" />
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="lumenna_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <!-- Tasker's action plugin (tasker/): the screen where an action is set up, which is the
             person's consent, and the receiver Tasker fires it through. Both are exported, as
             Tasker must reach them; the receiver runs only what carries a secret made when it was
             set up on this device. -->
        <activity
            android:name=".tasker.TaskerEditActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".tasker.TaskerFireReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>
        <!-- The home screen's widgets (widgets/Widgets), drawn from the core's glance. -->
        <receiver
            android:name=".widgets.NowWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now" />
        </receiver>
        <receiver
            android:name=".widgets.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today" />
        </receiver>
        <!-- The watch's own link to the phone (WatchLink): the system starts this when the
             other side opens a channel, so neither app need be in front. -->
        <service
            android:name=".PhoneLinkService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lumenna/sync" />
            </intent-filter>
        </service>
        <!-- Reminders' alarms and their notifications' Dismiss and Snooze: the app's own
             intents only. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />
        <!-- What moves every alarm: starting up, an update, the clock or zone changing, exact
             alarms granted. Each is a broadcast only the system sends. -->
        <receiver
            android:name=".ReminderRearmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
