<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Syncing with paired devices: Iroh connections, and knowing when there is a network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Hearing other devices on the local network (DNS-SD): Android passes multicast to an app
         only while it holds a multicast lock, which needs this. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- The store is not backed up to Google: it lives in no-backup storage, and syncing between
         paired devices is the way it reaches another. -->
    <application
        android:name=".LumennaApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumenna">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- New Task, from the launcher's shortcut and the Quick Settings tile. -->
            <intent-filter>
                <action android:name="io.github.emassey0135.lumenna.NEW_TASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <service
            android:name=".NewTaskTile"
            android:exported="true"
            android:icon="@drawable/ic_new_task"
            android:label="@string/new_task"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The watch's own link to the phone (WatchLink): the system starts this when the
             other side opens a channel, so neither app need be in front. -->
        <service
            android:name=".PhoneLinkService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lumenna/sync" />
            </intent-filter>
        </service>
    </application>
</manifest>
